# Supabase configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=your-project-url-here
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# LLM Provider: 'groq' (default) or 'gemini'
VITE_LLM_PROVIDER=groq

# Groq API (free tier — get key at https://console.groq.com)
VITE_GROQ_API_KEY=your-groq-api-key-here
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API (optional backup — https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=your-gemini-api-key-here
VITE_GEMINI_MODEL=gemini-2.0-flash-lite
